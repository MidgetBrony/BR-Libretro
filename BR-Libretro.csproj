<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>BR_Libretro</AssemblyName>
    <RootNamespace>BR_Libretro</RootNamespace>
    <AssemblyVersion>0.4.14.0</AssemblyVersion>
    <FileVersion>0.4.14.0</FileVersion>
    <Version>0.4.14</Version>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Compile Include="vendor\SK.Libretro\Scripts\**\*.cs" />
    <EmbeddedResource Include="assets\nes_cartridge.glb" LogicalName="BR_Libretro.Assets.nes_cartridge.glb" />
    <None Include="vendor\SK.Libretro\LICENSE" Pack="true" PackagePath="licenses\SK.Libretro-LICENSE" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Boxroom-TV2\Boxroom-TV.csproj" Private="false" />
    <ProjectReference Include="..\BR-MediaAPI\BR-MediaAPI.csproj" Private="false" />
    <Reference Include="Assembly-CSharp"><HintPath>$(GamePath)\BOXROOM_Data\Managed\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MelonLoader"><HintPath>$(GamePath)\MelonLoader\net35\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GamePath)\MelonLoader\net35\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(GamePath)\BOXROOM_Data\Managed\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GamePath)\BOXROOM_Data\Managed\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GamePath)\BOXROOM_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(GamePath)\BOXROOM_Data\Managed\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GamePath)\BOXROOM_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GamePath)\BOXROOM_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GamePath)\BOXROOM_Data\Managed\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GamePath)\BOXROOM_Data\Managed\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(GamePath)\BOXROOM_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(GamePath)\BOXROOM_Data\Managed\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="glTFast"><HintPath>$(GamePath)\BOXROOM_Data\Managed\glTFast.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(GamePath)\BOXROOM_Data\Managed\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(GamePath)\BOXROOM_Data\Managed\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FMODUnity"><HintPath>$(GamePath)\BOXROOM_Data\Managed\FMODUnity.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ModsPanel"><HintPath>$(GamePath)\Mods\ModsPanel.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateGamePath" BeforeTargets="ResolveReferences" Condition="!Exists('$(GamePath)\BOXROOM.exe')">
    <Error Text="GamePath must point to the BOXROOM installation." />
  </Target>
  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <MakeDir Directories="$(GamePath)\Mods" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\Mods" SkipUnchangedFiles="true" />
  </Target>
</Project>
